{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "contracts:build": "pnpm --dir ../.. --filter @rps/contracts build",
    "dev": "pnpm run contracts:build && next dev",
    "build": "pnpm run contracts:build && next build",
    "start": "pnpm run contracts:build && next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "check-types": "tsc --noEmit",
    "test": "pnpm run contracts:build && pnpm test:unit",
    "test:unit": "pnpm run contracts:build && vitest run",
    "test:e2e": "pnpm run contracts:build && playwright test",
    "test:e2e:smoke": "pnpm run contracts:build && playwright test e2e/two-player-flow.spec.ts e2e/error-contract-flow.spec.ts --trace off --grep '(create/join \\+ single mode full match|reconnect resume with token restores active game session|error contract: reconnect 없이 game 접근 시 joinUnavailable 표시)'"
  },
  "dependencies": {
    "@fxts/core": "^1.26.0",
    "@colyseus/sdk": "^0.17.42",
    "@rps/contracts": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "motion": "^12.29.2",
    "next": "16.2.7",
    "next-intl": "^4.13.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "7.3.2",
    "vitest": "^4.1.8"
  }
}
